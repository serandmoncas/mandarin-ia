# Azure Speech key (plan gratuito F0), used by the pipeline to synthesize audio
AZURE_SPEECH_KEY=
# Azure Speech region, e.g. eastus
AZURE_SPEECH_REGION=
# Supabase project URL, used to upload audio files
SUPABASE_URL=
# Supabase service role key (server/pipeline only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Public base URL where the audio files are served from
NEXT_PUBLIC_AUDIO_BASE_URL=
