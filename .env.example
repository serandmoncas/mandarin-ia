# Azure Speech key (plan gratuito F0), used by the pipeline to synthesize audio
AZURE_SPEECH_KEY=
# Azure Speech region, e.g. eastus
AZURE_SPEECH_REGION=
# Supabase Storage over S3 (Storage > S3 in the dashboard). Storage-only access keys:
# they reach every bucket but never the database. Pipeline only, never in Vercel or the browser.
SUPABASE_S3_ENDPOINT=https://<project_ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# Public base URL where the audio files are served from (trailing slash)
NEXT_PUBLIC_AUDIO_BASE_URL=https://<project_ref>.supabase.co/storage/v1/object/public/audio/
